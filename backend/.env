# Caregiver Platform Backend Environment Configuration
DEBUG=True
SECRET_KEY=django-insecure-caregiver-platform-dev-key-change-in-production-2026
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration (PostgreSQL 16+)
# If DB_PASSWORD or DB_ENGINE=postgresql is provided, PostgreSQL is used; otherwise defaults to SQLite for local development
DB_ENGINE=sqlite3
DB_NAME=caregiver_db
DB_USER=postgres
DB_PASSWORD=122184
DB_HOST=localhost
DB_PORT=5432

# AWS S3 Document Storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=caregiver-hipaa-documents
AWS_S3_REGION_NAME=us-east-1
S3_PRESIGNED_EXPIRATION_SECONDS=900
